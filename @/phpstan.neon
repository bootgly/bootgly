parameters:
   # Pin the analysis to the framework's target runtime (composer.json: php ^8.4).
   # Without it PHPStan follows the host runtime, so a machine running PHP 8.5
   # reports errors the CI (8.4) never sees.
   phpVersion: 80400
   level: 9
   excludePaths:
      analyse:
         - */&/*
         - */vs/*
         - */tests/*
         - */examples/*
         - */pages/*
         - */stubs/*
   reportUnmatchedIgnoredErrors: false

   paths:
      - ../Bootgly/
   ignoreErrors:
      - identifier: property.uninitializedReadonly
      - identifier: property.private
      - identifier: property.protected
      - identifier: property.readOnlyAssignNotInConstructor
      - identifier: property.readOnlyAssignOutOfClass
      - identifier: assign.propertyReadOnly
      -
         message: '#.*BOOTGLY_PROJECT not found\.#'
         identifier: constant.notFound
      -
         # mb_str_split polyfill shadows the ext-mbstring stub — PHPStan reads
         # the stub signature and skips the polyfill's @return docblock
         message: '#Function mb_str_split\(\) return type has no value type#'
         path: ../Bootgly/ABI/autoboot.php

services:
   -
      class: Bootgly\PHPStan\Rules\ConfigPropertiesExtension
      tags:
         - phpstan.broker.propertiesClassReflectionExtension
   -
      class: Bootgly\PHPStan\Rules\ConfigBindCollector
      tags:
         - phpstan.collector
   -
      class: Bootgly\PHPStan\Rules\ConfigGetCollector
      tags:
         - phpstan.collector

rules:
   - Bootgly\PHPStan\Rules\UnboundConfigAccessRule