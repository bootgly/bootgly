# ----------------------------------------------------------------------------
# Bootgly Docker — build context ignore (BuildKit, per-Dockerfile)
#
# Build context is the PARENT directory (/home/rodrigo/bootgly) so the `full`
# target can reach the sibling `bootgly_benchmarks/`. That parent holds many
# unrelated repos (bootgly_docs, bootgly_website, tmp, …) and multi-GB working
# data, so we ALLOWLIST: ignore everything, re-include only the paths the build
# needs, then re-ignore their heavy / irrelevant subpaths.
# Patterns are relative to the build context root (the parent directory).
# ----------------------------------------------------------------------------

# ? Ignore the entire context first
*

# ! Re-include only what the image is built from
!bootgly
!bootgly_benchmarks

# @ Security boundary — Git ignore rules do not apply to Docker contexts.
#   Never admit repository/agent metadata, environment secrets or the private
#   scripts that the source checkout deliberately keeps outside version control.
**/.git
**/.codex
**/.agent
**/.claude
**/.env
**/.env.*
bootgly/scripts/_*.php

# @ Public, versioned fixtures required by the full test/benchmark image.
#   Keep these exceptions exact: a wildcard fixture allowlist would let an
#   ignored secret placed beside one of them cross the boundary again.
!bootgly/Bootgly/API/Environment/Configs/tests/fixtures/configs/database/.env
!bootgly/Bootgly/API/Environment/Configs/tests/fixtures/configs/database/.env.development
!bootgly/Bootgly/API/Environment/Configs/tests/fixtures/configs/policy_bad_name/.env
!bootgly/Bootgly/API/Environment/Configs/tests/fixtures/configs/policy_environment/.env
!bootgly/Bootgly/API/Environment/Configs/tests/fixtures/configs/policy_environment/.env.development
!bootgly/Bootgly/API/Environment/Configs/tests/fixtures/configs/policy_environment/.env.production
!bootgly/Bootgly/API/Environment/Configs/tests/fixtures/configs/policy_extra/.env
!bootgly/Bootgly/API/Environment/Configs/tests/fixtures/configs/policy_good/.env
!bootgly/Bootgly/API/Environment/Configs/tests/fixtures/configs/policy_locked/.env
!bootgly/Bootgly/API/Environment/Configs/tests/fixtures/configs/server/.env
!bootgly/Bootgly/API/Environment/Configs/tests/fixtures/project/configs/database/.env
!bootgly/Bootgly/WPI/Nodes/HTTP_Server_CLI/Response/Resources/tests/fixtures/secure/kv/.env
!bootgly_benchmarks/HTTP_Server_CLI/bootables/laravel/.env
!bootgly_benchmarks/HTTP_Server_CLI/bootables/laravel/.env.example

# @ Trim bootgly/ — storage is ~5.4G, storage/temp ~421M, tmp ~789M, vendor is
#   rebuilt in-image. storage/ is runtime working data (temp/cache/sessions/pids/
#   bench marks) — the framework re-creates whatever subdirs it needs on demand.
bootgly/.github
bootgly/storage
bootgly/storage
bootgly/tmp
bootgly/vendor
bootgly/public
bootgly/docs

# @ Trim bootgly_benchmarks/
bootgly_benchmarks/.git
bootgly_benchmarks/storage
bootgly_benchmarks/scripts/.venv
# @ Keep competitor RUNTIMES out of the framework image (dependency-free).
#   The bench scripts/composer manifests stay; vendor/ + downloaded binaries do
#   not — the separate bootgly-bench image re-installs them per build ARG.
bootgly_benchmarks/**/vendor
bootgly_benchmarks/**/bootables/roadrunner/rr
bootgly_benchmarks/**/bootables/*/frankenphp

# @ Generic noise anywhere
**/.DS_Store
**/node_modules
**/*.log
**/.idea
**/.vscode
